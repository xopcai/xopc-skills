{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC scenario opportunities",
  "type": "object",
  "required": ["schemaVersion", "reviewedAt", "opportunities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "evidenceNeeded", "upstreamSignals"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "const": "upstream-signal-only" },
          "evidenceNeeded": { "type": "string", "minLength": 1 },
          "upstreamSignals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
