{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC Store functional categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "maxSkillsPerCategory", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "maxSkillsPerCategory": { "type": "integer", "minimum": 1, "maximum": 50 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "labels", "scenarioIds", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "zh-CN"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "zh-CN": { "type": "string", "minLength": 1 }
            }
          },
          "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "skills": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
