{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC released Skill catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "path", "version", "stage", "scenarioId", "origin", "license", "owner", "localizations", "compatibility", "qualityGates", "stableBlockers"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "stage": { "enum": ["experimental", "candidate", "stable", "deprecated"] },
    "scenarioId": { "type": "string" },
    "origin": { "enum": ["xopc-original", "xopc-adapted"] },
    "license": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "localizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "$ref": "#/$defs/localization" },
        "zh-CN": { "$ref": "#/$defs/localization" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["agents", "runtime", "os"],
      "properties": {
        "agents": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "runtime": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "os": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "qualityGates": { "type": "object" },
    "stableBlockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "description"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
