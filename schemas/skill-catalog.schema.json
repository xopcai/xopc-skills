{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC released Skill catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "path", "version", "stage", "scenarioId", "origin", "license", "owner", "compatibility", "qualityGates", "stableBlockers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "stage": { "enum": ["experimental", "candidate", "stable", "deprecated"] },
    "scenarioId": { "type": "string" },
    "origin": { "enum": ["xopc-original", "xopc-adapted"] },
    "license": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "compatibility": {
      "type": "object",
      "required": ["agents", "runtime", "os"],
      "properties": {
        "agents": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "runtime": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "os": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "qualityGates": { "type": "object" },
    "stableBlockers": { "type": "array", "items": { "type": "string" } }
  }
}
