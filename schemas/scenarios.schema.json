{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC skill scenarios",
  "type": "object",
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "domain", "stage", "strategy", "targetOutcome", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["discovery", "research", "approved", "building", "validated", "retired"] },
          "strategy": { "enum": ["build", "adopt", "adapt", "reimplement"] },
          "targetOutcome": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 18 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
