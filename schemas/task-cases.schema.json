{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC Skill task cases",
  "type": "object",
  "required": ["schemaVersion", "skill", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "skill": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "request", "fixture", "expected", "forbidden"],
        "properties": {
          "id": { "type": "string" },
          "request": { "type": "string", "minLength": 1 },
          "fixture": { "type": "string", "minLength": 1 },
          "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
