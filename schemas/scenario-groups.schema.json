{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOPC user scenario groups",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "maxSkillsPerGroup", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "maxSkillsPerGroup": { "type": "integer", "minimum": 1, "maximum": 20 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scenarioIds", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
