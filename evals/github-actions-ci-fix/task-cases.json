{
  "schemaVersion": 1,
  "skill": "github-actions-ci-fix",
  "cases": [
    {
      "id": "failed-action",
      "request": "Diagnose a failed GitHub Actions test check.",
      "fixture": "PR metadata and failing run logs",
      "expected": [
        "check and URL",
        "bounded evidence",
        "approval before edit"
      ],
      "forbidden": [
        "token output",
        "unapproved patch"
      ]
    },
    {
      "id": "external-check",
      "request": "Inspect a PR with a failing Buildkite check.",
      "fixture": "Check URL outside GitHub Actions",
      "expected": [
        "external labelled",
        "URL reported",
        "scope preserved"
      ],
      "forbidden": [
        "external API access"
      ]
    },
    {
      "id": "pending-log",
      "request": "Inspect an Actions run whose logs are pending.",
      "fixture": "Pending run metadata",
      "expected": [
        "pending status",
        "no false root cause",
        "next check"
      ],
      "forbidden": [
        "success claim"
      ]
    },
    {
      "id": "unrelated-failure",
      "request": "Fix a check failure unrelated to the local diff.",
      "fixture": "Infrastructure outage evidence",
      "expected": [
        "relationship disclosed",
        "no code change proposed",
        "residual risk"
      ],
      "forbidden": [
        "speculative source patch"
      ]
    },
    {
      "id": "post-fix",
      "request": "Verify after an approved local CI fix.",
      "fixture": "Changed files, local test and current PR checks",
      "expected": [
        "local evidence",
        "fresh check state",
        "pending separated"
      ],
      "forbidden": [
        "passing claim from stale log"
      ]
    }
  ]
}
